# All integrations are optional. Local tools work without API keys.

# Gemini: chat, summarization, and translation
GEMINI_API_KEY=

# OCR.Space: cloud OCR fallback
OCR_SPACE_API_KEY=

# ConvertAPI: high-fidelity PDF and Office conversion
CONVERT_API_SECRET=

# Cloudflare Web Analytics (privacy-friendly, cookieless, aggregate only).
# Leave empty to disable analytics entirely — nothing loads without it.
NEXT_PUBLIC_CF_BEACON_TOKEN=
